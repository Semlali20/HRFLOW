# ─────────────────────────────────────────────────────────────────────────────
# RH Manage — Docker Compose environment variables
# Copy this file to .env and fill in the values before running docker-compose.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=rhmanager
POSTGRES_USER=rhuser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_PORT=9200

# ── Backend (Spring Boot) ─────────────────────────────────────────────────────
BACKEND_PORT=8090

# DDL strategy: 'update' is safe for Docker (preserves data).
# Use 'create' only on first run with a fresh DB.
# Never use 'create-drop' in production.
DDL_AUTO=update

# JWT secret — must be at least 256 bits (32 chars) for HS256.
# Generate a strong random value: openssl rand -base64 64
JWT_SECRET=replace_with_a_very_long_random_secret_key_at_least_32_chars

# JWT token validity in milliseconds (86400000 = 24 h)
JWT_EXPIRATION_MS=86400000

# CORS: comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200

# ── SMTP (outgoing email) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=80

# ── Log levels ────────────────────────────────────────────────────────────────
# Options: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
